    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "file-type": "^22.1.1",
    "framer-motion": "^14.0.0",
