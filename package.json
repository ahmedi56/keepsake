    "db:migrate:test": "DATABASE_URL=postgres://keepsake:keepsake_dev@localhost:5432/keepsake_test drizzle-kit migrate",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "tsx scripts/smoke.ts"
  },
