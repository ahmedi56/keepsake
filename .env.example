# Database
DATABASE_URL=postgres://keepsake:keepsake_dev@localhost:5432/keepsake

# App
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional; leave empty to disable the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage: "local" (dev, files on disk) or "s3" (Cloudflare R2 / any S3-compatible)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Transcription: "whisper-cpp" (local binary, free) or "none"
TRANSCRIBE_DRIVER=none
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODEL_PATH=./models/ggml-small.bin

# Secret used to sign local-storage upload/download URLs (dev driver only)
STORAGE_SIGNING_SECRET=change-me-too-at-least-32-chars-long
